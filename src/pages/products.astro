---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import Crumbs from '../components/Crumbs.astro';
import QuickLinks from '../components/QuickLinks.astro';
import { getDoc, listOf, deref } from '../lib/content.js';
import { accent } from '../lib/text.js';
import { PRODUCT_FORMATS, PRODUCT_FEATURES } from '../lib/options.js';

const page = await getDoc('productsPage');
const industries = await listOf('industry');
const products = await Promise.all((await listOf('product')).map(async (p) => ({
  ...p,
  industrySlugs: (await Promise.all((p.industries || []).map(deref))).filter(Boolean).map((i) => i.slug?.current),
})));

const groups = [
  { name: 'format', title: 'Format', open: true, options: PRODUCT_FORMATS },
  { name: 'feature', title: 'Feature', open: true, options: PRODUCT_FEATURES },
  { name: 'industry', title: 'Industry', open: false, options: industries.map((i) => ({ title: i.title, value: i.slug?.current })) },
];
---
<Base seo={page.seo} title="Products" nav="products" css="products" scripts={['reveal', 'products']}>

  <section class="page-hero page-hero--band" aria-labelledby="page-title">
    <div class="container">
      <Crumbs items={[{ label: 'Home', href: '/' }, { label: 'Products' }]} />
      <div class="page-hero__grid">
        <div>
          <h1 class="page-hero__title" id="page-title" set:html={accent(page.title)} />
          <p class="page-hero__text">{page.text}</p>
          <form class="search search--left" role="search">
            <label class="visually-hidden" for="catalog-search">Search products</label>
            <input id="catalog-search" name="q" type="search" placeholder={page.searchPlaceholder} autocomplete="off" maxlength="60" data-catalog-search>
            <button class="round-btn" type="submit" aria-label="Search"><Icon name="search" /></button>
          </form>
        </div>
        <Media image={page.image} priority widths={[450, 900]} sizes="(max-width: 1023px) 100vw, 45vw" />
      </div>
    </div>
  </section>

  <section class="catalog" data-catalog aria-labelledby="catalog-title">
    <div class="container">
      <div class="catalog__head" aria-live="polite">
        <small>Products</small>
        <h2 class="catalog__count" id="catalog-title"><span data-catalog-label>All products</span> (<span data-catalog-count>{products.length}</span>)</h2>
      </div>
      <div class="catalog__grid">
        <aside class="filters" aria-label="Filter products">
          <button class="filters__toggle" type="button" aria-expanded="false" aria-controls="filters-body" data-toggle>Filter <Icon name="chevron-down" /></button>
          <div class="filters__body" id="filters-body">
            <p class="filters__title"><Icon name="filter" /> Filter</p>
            {groups.map((g) => (
              <details class="filters__group" open={g.open}>
                <summary>{g.title} <Icon name="chevron-down" /></summary>
                <div class="filters__options">
                  {g.options.map((o) => <label><input type="checkbox" name={g.name} value={o.value}> {o.title}</label>)}
                </div>
              </details>
            ))}
            <button class="filters__reset" type="button" data-catalog-reset>Clear all filters</button>
          </div>
        </aside>
        <div class="product-grid">
          {products.map((p) => (
            <article class="product-card" data-product data-format={(p.formats || []).join(' ')} data-feature={(p.features || []).join(' ')} data-industry={p.industrySlugs.join(' ')} data-keywords={p.keywords}>
              <Media image={p.image} widths={[400, 800]} sizes="(max-width: 767px) 100vw, 300px" />
              <h3 class="product-card__title"><button type="button" data-product-open>{p.title}</button></h3>
              <p class="product-card__text">{p.summary}</p>
              <span class="text-link">View details <Icon name="arrow" /></span>
              <div data-product-detail hidden>
                {p.about && <p>{p.about}</p>}
                {p.listItems?.length > 0 && <><h4>{p.listTitle}</h4><ul>{p.listItems.map((li) => <li>{li}</li>)}</ul></>}
                {p.offer?.length > 0 && <><h4>What we offer</h4><ul>{p.offer.map((li) => <li>{li}</li>)}</ul></>}
              </div>
            </article>
          ))}
          <p class="catalog__empty" data-catalog-empty hidden><strong>No product matches those filters.</strong>Most formats can be adapted. <button class="filters__reset" type="button" data-catalog-clear>Clear the filters</button> or <a class="accent" href="/contact/#enquiry">tell us what you need</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <dialog class="dialog" data-product-dialog aria-labelledby="dialog-title">
    <div class="dialog__inner">
      <div class="dialog__head">
        <h2 class="dialog__title" id="dialog-title" data-dialog-title>Product details</h2>
        <button class="dialog__close" type="button" aria-label="Close" data-dialog-close><Icon name="close" /></button>
      </div>
      <div class="dialog__content" data-dialog-content></div>
      <div class="dialog__foot">
        <a class="btn btn--solid btn--sm" href="/contact/#enquiry" data-dialog-quote><span class="btn__dot"><Icon name="chevron" /></span>Request a quote</a>
      </div>
    </div>
  </dialog>

  <QuickLinks except="products" />
</Base>

---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Media from '../../components/Media.astro';
import Crumbs from '../../components/Crumbs.astro';
import QuickLinks from '../../components/QuickLinks.astro';
import { getDoc, listOf } from '../../lib/content.js';
import { accent } from '../../lib/text.js';
import { BLOG_CATEGORIES } from '../../lib/options.js';

const page = await getDoc('blogPage');
const posts = await listOf('blogPost');
const used = new Set(posts.map((p) => p.category));
const categories = BLOG_CATEGORIES.filter((c) => used.has(c.value));
---
<Base seo={page.seo} title="Blog" nav="blog" css="blog" scripts={['reveal', 'filter']}>

  <section class="page-hero page-hero--band" aria-labelledby="page-title">
    <div class="container">
      <Crumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog' }]} />
      <h1 class="page-hero__title page-hero__title--xl" id="page-title" set:html={accent(page.title)} />
      <p class="page-hero__text">{page.text}</p>
    </div>
  </section>

  <section class="section blog" data-filter aria-labelledby="posts-title">
    <div class="container">
      <div class="guides__head">
        <h2 class="section-title section-title--sm" id="posts-title" set:html={accent(page.listTitle)} />
        <div class="pills" role="group" aria-label="Filter articles">
          <button class="pill is-active" type="button" data-filter-value="all" aria-pressed="true">All</button>
          {categories.map((c) => <button class="pill" type="button" data-filter-value={c.value} aria-pressed="false">{c.title}</button>)}
        </div>
      </div>
      <div class="posts" data-filter-list>
        {posts.map((post, i) => (
          <a class:list={['post-card', { 'post-card--lead': i === 0 }]} href={`/blog/${post.slug?.current}/`} data-tags={post.category} data-reveal style={`--i:${i === 0 ? 0 : (i - 1) % 3}`}>
            <Media image={post.image} widths={[480, 800, 1264]} sizes={i === 0 ? '(max-width: 767px) 100vw, 50vw' : '(max-width: 767px) 100vw, 33vw'} />
            <div class="post-card__body">
              <ul class="guide__tags">{(post.tags || []).map((t) => <li>{t}</li>)}</ul>
              <h3 class="post-card__title">{post.title}</h3>
              <p class="post-card__text">{post.excerpt}</p>
              <p class="post-card__meta"><span>{post.readMinutes} min read</span><span class="round-btn round-btn--soft"><Icon name="arrow" /></span></p>
            </div>
          </a>
        ))}
      </div>
      <p class="blog__empty" data-filter-empty hidden>No articles in this category yet.</p>
    </div>
  </section>

  <QuickLinks />
</Base>

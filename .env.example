# Copy this file to `.env` and fill it in. `.env` is gitignored.
#
# Project id: sanity.io/manage -> Spectra Pack -> the id under the project name.
# It is not secret (it appears in every image address). Leave it empty and the
# site builds from content/seed.json instead of Sanity.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Only needed once, for `npm run import`. Create it at:
#   sanity.io/manage -> Spectra Pack -> API -> Tokens -> Add API token
#   Name: "Content import"   Permissions: Editor
#
# This token can edit and delete all content. Treat it like a password: never
# paste it into a chat, an email, or a file that gets committed. Delete the
# token in sanity.io/manage once the import is done.
SANITY_WRITE_TOKEN=
